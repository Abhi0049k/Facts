TAVILY_API_KEY=
BRIGHT_DATA_API_TOKEN=
# Web Unlocker zone name from Bright Data control panel (Overview tab).
# Used for arbitrary company homepages when COLLECTOR_COMPANY_SITE is empty.
# Copy the zone name from the Unlocker Overview tab, or leave blank to auto-detect.
BRIGHT_DATA_WEB_UNLOCKER_ZONE=web_unlocker1
# Optional: gd_… Datasets API scraper or c_… Scraper Studio collector for homepages.
BRIGHT_DATA_COLLECTOR_COMPANY_SITE=
# Published Datasets API IDs (override with your own c_… collectors if you prefer).
BRIGHT_DATA_COLLECTOR_CRUNCHBASE=gd_l1vijqt9jfj7olije
BRIGHT_DATA_COLLECTOR_LINKEDIN=gd_l1vikfnt1wgvvqz95w
# Optional India filings source; leave empty to skip.
BRIGHT_DATA_COLLECTOR_TOFLER=
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2:latest

# Supabase Postgres (never commit real values; put them in .env.local)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
