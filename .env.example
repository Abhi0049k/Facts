# Search & Scraper APIs
TAVILY_API_KEY=your_tavily_api_key_here
BRIGHT_DATA_API_TOKEN=your_bright_data_api_token_here
BRIGHT_DATA_WEB_UNLOCKER_ZONE=your_unlocker_zone_here
BRIGHT_DATA_COLLECTOR_COMPANY_SITE=
BRIGHT_DATA_COLLECTOR_CRUNCHBASE=your_crunchbase_collector_id_here
BRIGHT_DATA_COLLECTOR_LINKEDIN=your_linkedin_collector_id_here
